                  py.Statement('if i != len(parser.s): raise ParseError("Failed to consume all input")')
              ]),
              py.Compound('except ParseError as pe', [
                  py.Statement('stderr.write("Parse error: %s\\n" % pe.reason)'),
                  py.Statement('SortTraces(parser.lastMatch).sort()'),
                  py.Statement('newlines = [0]'),
                  py.Compound('for line in parser.s.split(u"\\n")', [
                      py.Statement('newlines.append(newlines[-1] + len(line) + 1)')
                  ]),
                  py.Compound('for k, start, stop in parser.lastMatch[:10]', [
                      py.Statement('startLine = lineNumber(parser.s, start)'),
                      py.Statement('startCol = start - newlines[startLine]'),
                      py.Statement('stopLine = lineNumber(parser.s, stop)'),
                      py.Statement('stopCol = stop - newlines[stopLine]'),
                      py.Statement('t = k.encode("utf-8"), startLine + 1, startCol, stopLine + 1, stopCol'),
                      py.Statement('stderr.write(("Trail: %s (%d:%d - %d:%d)" % t) + chr(10))')
                  ]),
                  py.Statement('return 1')
              ]),
              py.Statement('root = parser.builtin.makeFlatten(l)'),
              py.Statement('try: iterations = saturate(uf, parser, limit, nodeLimit, verbose, stderr)'),
              py.Compound('except ZaddyError as ze', [
                  py.Statement('stderr.write("Error: %s\\n" % ze.message)'),
                  py.Statement('return 3')
              ]),
              py.Compound('if verbose', [
                  py.Compound('for rule in ruleList', [
                      py.Statement('if rule.fired: stderr.write("Rule %s: %d applications\\n" % (rule.name, rule.fired))')
                  ])
              ]),
              py.Statement('ex = Extractor(uf)'),
              py.Statement('ex.run()'),
              py.Statement('root = uf.find(root)'),
              py.Compound('if ex.costL[root] >= INF', [
                  py.Statement('stderr.write("Error: no output could be extracted after %d iterations\\n" % iterations)'),
                  py.Statement('stderr.write("Constructors which were never rewritten:\\n")'),
                  py.Statement('for t in describeStuck(ex.diagnose(root))[:20]: stderr.write("  %s\\n" % t.encode("utf-8"))'),
                  py.Statement('return 3')
              ]),
              py.Statement('buf = []'),
              py.Statement('ex.emitList(root, 0, buf)'),
              py.Statement('stdout.write(u"\\n".join(buf).encode("utf-8"))'),
              py.Statement('stdout.write("\\n")'),
              py.Statement('if verbose: stderr.write("Wrote %d lines after %d iterations\\n" % (len(buf), iterations))'),
              py.Statement('return 0')
          ])
          ], *Clss, [
          py.Statement('frozenRels = dict(allRels)'),
          py.Statement('unrolledRels = unrolling_iterable(frozenRels)'),
          py.Statement('frozenLets = letNames[:]'),
