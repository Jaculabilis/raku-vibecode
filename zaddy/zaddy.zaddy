              py.Statement('def makeLength(self, s): return self.uf.struct(self.ns, u"Length", FREE, [s])'),
              py.Statement('def makeJoin(self, s, ps): return self.uf.struct(self.ns, u"Join", FREE, [s, ps])'),
              py.Statement('def makeConcat(self, p, ps): return self.uf.struct(self.ns, u"Concat", FREE, [p, ps])')
          ]),
          py.Statement('allRels.append(("builtin", builtinRels))'),
          py.Compound('def evalBuiltins(uf, out)', [
              py.Compound('for n in uf.tagged(u"builtin", u"Flatten")[:]', [
                  py.Statement('if not n.live(): continue'),
                  py.Compound('for ls in uf.listsOf(n.args[0])', [
                      py.Compound('if len(ls) == 1', [
                          py.Statement('out.append((n.cls, ls[0]))'),
                          py.Statement('continue')
                      ]),
                      py.Statement('choices = [uf.listsOf(x) for x in ls]'),
                      py.Statement('for l in productInts(choices): out.append((n.cls, uf.makeList(l)))')
                  ])
              ]),
              py.Compound('for n in uf.tagged(u"builtin", u"Length")[:]', [
                  py.Statement('if not n.live(): continue'),
                  py.Statement('s = uf.minStr(n.args[0])'),
                  py.Statement('if s is not None: out.append((n.cls, uf.makeStr(str(len(s)).decode("utf-8"))))')
              ]),
              py.Compound('for n in uf.tagged(u"builtin", u"Join")[:]', [
                  py.Statement('if not n.live(): continue'),
                  py.Statement('sep = uf.minStr(n.args[0])'),
                  py.Statement('if sep is None: continue'),
                  py.Compound('for ls in uf.listsOf(n.args[1])', [
                      py.Statement('parts = minStrs(uf, ls)'),
                      py.Statement('if parts is not None: out.append((n.cls, uf.makeStr(sep.join(parts))))')
                  ])
              ]),
              py.Compound('for n in uf.tagged(u"builtin", u"Concat")[:]', [
                  py.Statement('if not n.live(): continue'),
                  py.Compound('for ls in uf.listsOf(n.args[1])', [
                      py.Compound('if len(ls) == 0', [
                          py.Statement('out.append((n.cls, n.args[0]))'),
                          py.Statement('continue')
                      ]),
                      py.Statement('parts = minStrs(uf, [n.args[0]] + ls)'),
                      py.Statement('if parts is not None: out.append((n.cls, uf.makeStr(u"".join(parts))))')
                  ])
              ])
          ]),
          py.Compound('def minStrs(uf, cs)', [
              py.Statement('rv = []'),
              py.Compound('for c in cs', [
                  py.Statement('s = uf.minStr(c)'),
                  py.Statement('if s is None: return None'),
                  py.Statement('rv.append(s)')
              ]),
              py.Statement('return rv')
          ]),
          py.Compound('def saturate(uf, parser, limit, nodeLimit, verbose, stderr)', [
              py.Statement('iteration = 0'),
              py.Compound('while iteration < limit', [
                  py.Statement('uf.rebuild()'),
                  py.Statement('before = uf.changes + uf.unions'),
                  py.Statement('matches = []'),
                  py.Compound('for rule in ruleList', [
                      py.Compound('for n in rule.patt.candidates(uf)', [
                          py.Statement('if not n.live(): continue'),
                          py.Statement('envs = []'),
                          py.Statement('rule.patt.matchNode(uf, n, None, envs)'),
                          py.Statement('for env in envs: matches.append(Match(rule, n, env))'),
                          py.Statement('rule.patt.extend(uf, rule, n, matches)')
                      ])
                  ]),
                  py.Statement('pending = []'),
                  py.Statement('evalBuiltins(uf, pending)'),
                  py.Compound('for m in matches', [
                      py.Statement('try: rv = m.rule.rhs(uf, parser, Bindings(uf, m.env, m.rule.name))'),
                      py.Statement('except NoResults: continue'),
                      py.Statement('for c in rv: uf.union(m.node.cls, c)'),
                      py.Statement('if m.rule.simplify: uf.subsume(m.node)'),
                      py.Statement('m.rule.fired += 1')
                  ]),
                  py.Statement('for (a, b) in pending: uf.union(a, b)'),
                  py.Statement('iteration += 1'),
                  py.Statement('if verbose: stderr.write("Iteration %d: %d matches, %d classes, %d nodes\\n" % (iteration, len(matches), len(uf.parent), len(uf.nodes)))'),
                  py.Statement('if uf.changes + uf.unions == before: break'),
                  py.Compound('if len(uf.nodes) > nodeLimit', [
                      py.Statement('stderr.write("Warning: stopped after %d iterations at the limit of %d e-nodes\\n" % (iteration, nodeLimit))'),
                      py.Statement('break')
                  ])
              ]),
              py.Statement('uf.rebuild()'),
              py.Statement('return iteration')
          ]),
          py.Statement('TSTR = 0'),
          py.Statement('TLINE = 1'),
          py.Statement('TLIST = 2'),
          py.Compound('class Extractor(object)', [
              py.Compound('def __init__(self, uf)', [
                  py.Statement('self.uf = uf'),
                  py.Statement('size = len(uf.parent)'),
                  py.Statement('self.costS = [INF] * size'),
                  py.Statement('self.bestS = [u""] * size'),
                  py.Statement('self.costB = [INF] * size'),
                  py.Statement('self.bestB = [None] * size'),
                  py.Statement('self.costL = [INF] * size'),
                  py.Statement('self.bestL = [None] * size')
              ]),
              py.Compound('def run(self)', [
                  py.Statement('uf = self.uf'),
                  py.Statement('changed = True'),
                  py.Compound('while changed', [
                      py.Statement('changed = False'),
                      py.Compound('for n in uf.nodes', [
                          py.Statement('if not n.live(): continue'),
                          py.Statement('c = uf.find(n.cls)'),
                          py.Compound('if n.kind == NSTR', [
                              py.Compound('if self.costS[c] > 1 or (self.costS[c] == 1 and shortlexLess(n.s, self.bestS[c]))', [
                                  py.Statement('self.costS[c] = 1; self.bestS[c] = n.s; changed = True')
                              ])
                          ]),
                          py.Compound('elif n.kind == NLIST', [
                              py.Statement('cost = 1'),
                              py.Compound('for a in n.args', [
                                  py.Statement('cost += self.costB[uf.find(a)]'),
                                  py.Statement('if cost >= INF: break')
                              ]),
                              py.Compound('if cost < self.costL[c]', [
                                  py.Statement('self.costL[c] = cost; self.bestL[c] = n; changed = True')
                              ])
                          ]),
                          py.Compound('elif n.ns == u"builtin" and n.con == u"Line"', [
                              py.Statement('cost = 1 + self.costS[uf.find(n.args[0])]'),
                              py.Compound('if cost < self.costB[c]', [
                                  py.Statement('self.costB[c] = cost; self.bestB[c] = n; changed = True')
                              ])
                          ]),
                          py.Compound('elif n.ns == u"builtin" and n.con == u"Block"', [
                              py.Statement('cost = 1 + self.costL[uf.find(n.args[0])]'),
                              py.Compound('if cost < self.costB[c]', [
                                  py.Statement('self.costB[c] = cost; self.bestB[c] = n; changed = True')
                              ])
                          ])
                      ])
                  ])
              ]),
              py.Compound('def emitList(self, c, depth, buf)', [
                  py.Statement('n = self.bestL[self.uf.find(c)]'),
                  py.Statement('assert n is not None'),
                  py.Statement('for a in n.args: self.emitLine(a, depth, buf)')
              ]),
              py.Compound('def emitLine(self, c, depth, buf)', [
                  py.Statement('n = self.bestB[self.uf.find(c)]'),
                  py.Statement('assert n is not None'),
                  py.Statement('if n.con == u"Line": buf.append(u" " * (depth * 4) + self.bestS[self.uf.find(n.args[0])])'),
                  py.Statement('else: self.emitList(n.args[0], depth + 1, buf)')
              ]),
              py.Compound('def diagnose(self, root)', [
                  py.Statement('uf = self.uf'),
                  py.Statement('seen = {}'),
                  py.Statement('stack = [uf.find(root)]'),
                  py.Statement('stuck = []'),
                  py.Compound('while stack', [
                      py.Statement('c = stack.pop()'),
                      py.Statement('if c in seen: continue'),
                      py.Statement('seen[c] = None'),
                      py.Statement('ok = self.costS[c] < INF or self.costB[c] < INF or self.costL[c] < INF'),
                      py.Compound('for n in uf.members[c]', [
                          py.Statement('if not n.live(): continue'),
                          py.Statement('for a in n.args: stack.append(uf.find(a))'),
                          py.Statement('if ok or n.kind != NSTRUCT or n.ns == u"builtin": continue'),
                          py.Statement('stuck.append(n.tag())')
                      ])
                  ]),
                  py.Statement('return stuck')
              ])
          ]),
          py.Compound('def describeStuck(stuck)', [
              py.Statement('counts = {}'),
              py.Statement('order = []'),
              py.Compound('for t in stuck', [
                  py.Compound('if t not in counts', [
                      py.Statement('counts[t] = 0'),
                      py.Statement('order.append(t)')
                  ]),
                  py.Statement('counts[t] += 1')
              ]),
              py.Statement('return [t + u" (" + str(counts[t]).decode("utf-8") + u")" for t in order]')
          ]),
          py.Compound('def lineNumber(s, i)', [
              py.Statement('assert i >= 0'),
              py.Statement('return s.count(unichr(10), 0, i)')
          ]),
          py.Statement('SortTraces = make_timsort_class(lt=lambda l, r: l[2] > r[2])'),
          py.Statement('USAGE = "usage: %s [-v] [-i ITERATIONS] [-n NODES] < input > output\\n"'),
          py.Compound('def main(argv)', [
              py.Statement('stdin, stdout, stderr = create_stdio()'),
              py.Statement('verbose = False'),
              py.Statement('limit = 1000'),
              py.Statement('nodeLimit = 1000000'),
              py.Statement('i = 1'),
              py.Compound('while i < len(argv)', [
                  py.Statement('if argv[i] == "-v": verbose = True'),
                  py.Compound('elif argv[i] == "-i" and i + 1 < len(argv)', [
                      py.Statement('i += 1'),
                      py.Statement('limit = int(argv[i])')
                  ]),
                  py.Compound('elif argv[i] == "-n" and i + 1 < len(argv)', [
                      py.Statement('i += 1'),
                      py.Statement('nodeLimit = int(argv[i])')
                  ]),
                  py.Compound('else', [
                      py.Statement('stderr.write(USAGE % argv[0])'),
                      py.Statement('return 2')
                  ]),
                  py.Statement('i += 1')
              ]),
              py.Statement('uf = UF()'),
              py.Statement('parser = MainParser(stdin.read().decode("utf-8"), uf)'),
              py.Compound('try', [
