-- Zaddy, described in Zaddy.
--
-- Compiled by any Zaddy compiler, this file yields an RPython program which
-- compiles Zaddy programs to RPython programs.  Compiled by itself, it yields
-- rzaddy/zaddy.py exactly.  See doc/zaddy.md for the language reference.
--
-- Algebras:
--   py      indented Python source, lowered to builtin lines and blocks
--   peg     parsing expressions, lowered to py statements
--   zephyr  signatures, lowered to py classes with one method per constructor
--   rules   patterns and productions, lowered to Python expressions
--   char    character classes, lowered to Python boolean expressions

.signature py

statement = Statement(string line)
          | Imp(string module, string names)
          | Ret(string expr)
          | RaiseIf(string test)
          | ContIf(string test)
          | Compound(string head, statement* block)
          | Conditional(string test, statement* block)
          | Handler(statement* block, statement* handler)

.signature peg

pattern = NamePatt(string name)

expr = Null
     | Token(string s)
     | Call(string s)
     | Sequence(expr* exprs)
     | Choice(expr this, expr that)
     | Any(expr expr)
     | Some(expr expr)
     | Maybe(expr expr)
     | Positive(expr expr)
     | Negative(expr expr)
     | Capture(expr expr, pattern patt)
     | Production(expr expr, prod prod)

.signature zephyr

signature = Signature(string name, type* tys)
type = Product(string name, field* fs)
     | Sum(string name, string* attrs, constructor con, constructor* cons)
constructor = Con(string tag, field* args, string kind)
field = Id(string ty, string name)
      | Option(string ty, string name)
      | Sequence(string ty, string name)

.signature rules

patt = IgnorePatt
     | VarPatt(string n)
     | SplicePatt(string n)
     | StrPatt(string s)
     | StructPatt(string ns, string func, patt* vars)
     | ListPatt(patt* ps)
production = VarProd(string name)
           | ConstProd(string name)
           | StrProd(string s)
           | CharProd(int n)
           | StructProd(string ns, string func, production* ps)
           | ListProd(production* ps)
           | SpliceListProd(production* items)
           | ItemProd(production p)
           | SpliceProd(string name)
           | FlattenOp(production p)
           | LengthOp(production p)
           | JoinOp(string s, production p)
           | ConcatOp(production p, production* ps)
           | GenSym(string s)
rule = Rewrite(string name, patt root, production* prods, string simplify)
     | Let(string name, production p)

.signature char

set = Any
    | Exactly(char c)
    | Range(set l, set u)
    | Call(string n)
    | Complement(set s)
    | Either(set l, set r)

.rules

-- Lowering the py algebra to the builtin line/block algebra.  Sugar is
-- rewritten into other py constructors; nested list patterns keep the rules
-- for empty and non-empty blocks disjoint.

pyImp       @ py.Imp(M, Ns)  ==> py.Statement('from ' M ' import ' Ns) ;
pyRet       @ py.Ret(E)      ==> py.Statement('return ' E) ;
pyRaiseIf   @ py.RaiseIf(T)  ==> py.Statement('if ' T ': raise ParseError("no reason")') ;
pyContIf    @ py.ContIf(T)   ==> py.Statement('if ' T ': continue') ;
pyStatement @ py.Statement(L) ==> [.line(L)] ;
pyCompPass  @ py.Compound(H, [])          ==> [.line(H ': pass')] ;
pyCompBlock @ py.Compound(H, [S, Ss…])    ==> [.line(H ':'), .block(*[S, Ss…])] ;
pyCondEmpty @ py.Conditional(T, [])       ==> [] ;
pyCondBlock @ py.Conditional(T, [S, Ss…]) ==> [.line('if ' T ':'), .block(*[S, Ss…])] ;
pyHandEmpty @ py.Handler(B, [])           ==> [] ;
pyHandBlock @ py.Handler(B, [S, Ss…])     ==> [.line('try:'), .block(*B),
                                               .line('except ParseError as pe:'), .block(*[S, Ss…])] ;


-- Packrat parsing.  Each rule becomes a method returning (position, value);
-- choice and repetition save positions on a stack and backtrack on ParseError.

pegNamePatt  @ peg.NamePatt(Name) ==> 'env.set(u"' Name '", rv)' ;

let save       := py.Statement('st.append(i)') ;
let backup     := py.Statement('i = st.pop()') ;
let boundcheck := py.RaiseIf('i >= len(self.s)') ;
let skipws     := py.Statement('while i < len(self.s) and ord(self.s[i]) in [9, 10, 13, 32]: i += 1') ;

pegSeq      @ peg.Sequence(Es)     ==> *Es ;
pegCap      @ peg.Capture(E, P)    ==> [E…, py.Statement(P)] ;
pegProd     @ peg.Production(E, P) ==> [E…, py.Statement('rv = ' P)] ;
pegCall     @ peg.Call(S)          ==> [py.Statement('i, rv = self.parse' S '(i)')] ;
pegChoice   @ peg.Choice(L, R)     ==> [save, py.Handler(L, [backup, R…])] ;
pegToken    @ peg.Token(S)         ==> [skipws, boundcheck,
                                        py.Statement('assert i >= 0'),
                                        py.RaiseIf('self.s[i:i + ' #S '] != u"' S '"'),
                                        py.Statement('self.lastMatch.append((u"TOKEN ' S '", i, i + ' #S '))'),
                                        py.Statement('rv = self.uf.makeStr(u"' S '"); i += ' #S)] ;
pegAny      @ peg.Any(E)           ==> [py.Statement('rvs = []'),
                                        py.Compound('while True',
                                            [save,
                                             py.Handler([E…, py.Statement('rvs.append(rv)')],
                                                        [backup, py.Statement('break')])]),
                                        py.Statement('rv = rel.uf.makeList(rvs)')] ;
pegSome     @ peg.Some(E)          ==> *[peg.Any(E), [py.RaiseIf('not len(rvs)')]] ;

pegMaybe    @ peg.Maybe(E)         ==> [save, py.Handler(E, [py.Statement('rv = 0'), backup])] ;
pegPos      @ peg.Positive(E)      ==> [save,
                                        py.Handler([E…, py.Statement('rv = True')],
                                                   [py.Statement('rv = False')]),
                                        backup,
                                        py.RaiseIf('not rv')] ;
pegNeg      @ peg.Negative(E)      ==> [save,
                                        py.Handler([E…, py.Statement('rv = True')],
                                                   [py.Statement('rv = False')]),
                                        backup,
                                        py.RaiseIf('rv')] ;


-- Signatures become classes whose makeCon methods intern e-nodes.  The
-- constructor kind is 0 (free), 1 (.comm), 2 (.assoc) or 3 (.ac).

zSig    @ zephyr.Signature(N, T)    ==> [py.Compound('class ' N 'Rels(object)', *[[
                                             py.Statement('ns = u"' N '"'),
                                             py.Statement('def __init__(self, uf): self.uf = uf')
                                         ], *T]),
                                         py.Statement('allRels.append(("' N '", ' N 'Rels))')] ;
zProd   @ zephyr.Product(N, Fs)     ==> [py.Statement('# product ' N)] ;
zSum    @ zephyr.Sum(N, A, C, Cs)   ==> *[C, *Cs] ;
zConF   @ zephyr.Con(T, A, K)       ==> [py.Statement('def make' T '(self, ' .join(A, ', ') '): return self.uf.struct(self.ns, u"' T '", ' K ', [' .join(A, ', ') '])')] ;
zOpt    @ zephyr.Option(T, N)       ==> N ;
zSeq    @ zephyr.Sequence(T, N)     ==> N ;
zId     @ zephyr.Id(T, N)           ==> N ;


-- Character classes.

charAny     @ char.Any           ==> 'True' ;
charExactly @ char.Exactly(C)    ==> 'c == ' C ;
charRange   @ char.Range(L, U)   ==> L ' <= c <= ' U ;
charCall    @ char.Call(N)       ==> 'self.cls' N '(c)' ;
charComp    @ char.Complement(S) ==> 'not (' S ')' ;
charEither  @ char.Either(L, R)  ==> '(' L ') or (' R ')' ;


-- Rules.  Patterns become matcher objects built at import time; productions
-- become expressions which intern e-nodes, reading pattern variables from env.

rPattIg @ rules.IgnorePatt                 ==> 'PIgnore()' ;
rPattV  @ rules.VarPatt(N)                 ==> 'PVar(u"' N '")' ;
rPattSp @ rules.SplicePatt(N)              ==> 'PSplice(u"' N '")' ;
rPattS  @ rules.StrPatt(S)                 ==> 'PStr(u' 39 S 39 ')' ;
rPattSt @ rules.StructPatt(Ns, F, Ps)      ==> 'PStruct(u"' Ns '", u"' F '", [' .join(Ps, ', ') '])' ;
rPattL  @ rules.ListPatt(Ps)               ==> 'PList([' .join(Ps, ', ') '])' ;
rProdV  @ rules.VarProd(Name)              ==> 'env.get(u"' Name '")' ;
rProdC  @ rules.ConstProd(Name)            ==> 'rel.const' Name ;
rProdS  @ rules.StrProd(S)                 ==> 'uf.makeStr(u' 39 S 39 ')' ;
rProdCh @ rules.CharProd(N)                ==> 'uf.makeStr(unichr(' N '))' ;
rProdSt @ rules.StructProd(Ns, F, Ps)      ==> 'rel.' Ns '.make' F '(' .join(Ps, ', ') ')' ;
rProdL  @ rules.ListProd(Ps)               ==> 'uf.makeList([' .join(Ps, ', ') '])' ;
rProdSL @ rules.SpliceListProd(Is)         ==> 'uf.makeList([]' .join(Is, '') ')' ;
rProdI  @ rules.ItemProd(P)                ==> ' + [' P ']' ;
rProdSp @ rules.SpliceProd(N)              ==> ' + env.elems(u"' N '")' ;
rProdOF @ rules.FlattenOp(P)               ==> 'rel.builtin.makeFlatten(' P ')' ;
rProdOL @ rules.LengthOp(P)                ==> 'rel.builtin.makeLength(' P ')' ;
rProdOJ @ rules.JoinOp(S, P)               ==> 'rel.builtin.makeJoin(uf.makeStr(u"' S '"), ' P ')' ;
rProdOC @ rules.ConcatOp(P, Ps)            ==> 'rel.builtin.makeConcat(' P ', uf.makeList([' .join(Ps, ', ') ']))' ;
rGenSym @ rules.GenSym(S)                  ==> 'uf.makeStr(rel.gensym(u"' S '"))' ;
rRule   @ rules.Rewrite(Name, Pat, Ps, K)  ==> [py.Compound('def rhs' Name '(uf, rel, env)', [
                                                    py.Ret('[' .join(Ps, ', ') ']')
                                                ]),
                                                py.Statement('ruleList.append(Rule("' Name '", ' Pat ', rhs' Name ', ' K '))')] ;
rLet    @ rules.Let(Name, P)               ==> [py.Statement('@let'),
                                                py.Statement('def let' Name '(uf, rel): rel.const' Name ' = ' P)] ;

.grammar ZADDY

-- The grammar of Zaddy itself.  The start rule ZADDY wraps the translated
-- sections in the runtime, which is written below as py terms.

class Whitespace = 9 | 10 | 13 | 32 ;
class Digit = .range(48:57) ;
class Upper = .range(65:90) ;
class Lower = .range(97:122) ;
class Alpha = Upper | Lower ;
class Alphanumeric = Alpha | Digit ;
class Quote = 39 ;
class Quoted = ~( 10 | 13 | 39 ) ;
class Ellipsis = 8230 ;
class NotNewline = ~( 10 ) ;

token WS = Whitespace* ;
token Number = Digit+ ;
token Id = Alpha Alphanumeric* ;
token PVar = Upper Alphanumeric* ;
token PConst = Lower+ ;
token ZTId = Lower Alphanumeric* ;
token ZCId = Upper Alphanumeric* ;
token Quote = Quote ;
token Quoted = Quoted* ;
token Ellipsis = Ellipsis ;
token CommentText = NotNewline* ;

STRING := WS Quote Quoted:Q Quote -> Q ;
ID := WS Id ;
DOTS := Ellipsis / '...' ;
COMMENT := '--' CommentText -> [] ;

SIGNATURE := '.signature' ID:Name ( ZTY / COMMENT )*:Tys -> zephyr.Signature(Name, *Tys) ;
ZTY := ID:Name '='
      ( FIELDS:Fs -> [zephyr.Product(Name, Fs)]
        / ZCON:Con ( '|' ZCON )*:Cons
          ( 'attributes' FIELDS:Attrs -> [zephyr.Sum(Name, Attrs, Con, Cons)]
          / -> [zephyr.Sum(Name, [], Con, Cons)] ) ) ;
ZCON := WS ( ZCId:Tag FIELDS:Args ZKIND:K -> zephyr.Con(Tag, Args, K)
           / ZCId:Tag ZKIND:K -> zephyr.Con(Tag, [], K) ) ;
ZKIND := '.comm' -> '1'
       / '.assoc' -> '2'
       / '.ac' -> '3'
       / -> '0' ;
FIELDS := '(' FIELD:F ( ',' FIELD )*:Fs ')' -> *[[F], Fs] ;
FIELD := WS ( ZTId:Ty '?' ID:Name -> zephyr.Option(Ty, Name)
            / ZTId:Ty '*' ID:Name -> zephyr.Sequence(Ty, Name)
            / ZTId:Ty ID:Name     -> zephyr.Id(Ty, Name) ) ;

RULES := '.rules' ( CHRULE / CHLET / COMMENT )*:Hs -> *Hs ;
CHRULE := ID:Name '@' WS CPATT:Root
          ( '==>' CPRODS:Prods ';' -> rules.Rewrite(Name, Root, Prods, '0')
          / '<=>' CPRODS:Prods ';' -> rules.Rewrite(Name, Root, Prods, '1') ) ;
CHLET := 'let' ID:Name ':=' CPROD1:P ';' -> rules.Let(Name, P) ;
CPATTS := WS CPATT:P ( ',' WS CPATT )*:Ps -> *[[P], Ps] ;
PITEM := WS PVar:N DOTS -> rules.SplicePatt(N)
       / WS CPATT ;
PITEMS := PITEM:P ( ',' PITEM )*:Ps -> *[[P], Ps] ;
CPATT := '_'                                 -> rules.IgnorePatt
       / '[]'                                -> rules.ListPatt([])
       / '[' PITEMS:Ps ']'                   -> rules.ListPatt(Ps)
       / STRING:S                            -> rules.StrPatt(S)
       / ID:Ns '.' ID:Func '(' CPATTS:Ps ')' -> rules.StructPatt(Ns, Func, Ps)
       / ID:Ns '.' ID:Func                   -> rules.StructPatt(Ns, Func, [])
       / WS PVar:Name !DOTS                  -> rules.VarPatt(Name) ;
CPRODS := CPROD1:P ( ',' CPROD1 )*:Ps -> *[[P], Ps] ;
CPROD1 := WS CPROD2:P ( WS CPROD2 )+:Ps -> rules.ConcatOp(P, Ps)
        / WS CPROD2 ;
QITEM := WS PVar:N DOTS -> rules.SpliceProd(N)
       / CPROD1:P       -> rules.ItemProd(P) ;
QITEMS := QITEM:P ( ',' QITEM )*:Ps -> *[[P], Ps] ;
CPROD2 := STRING:S                            -> rules.StrProd(S)
        / Number:N                            -> rules.CharProd(N)
        / '.gensym(' STRING:S ')'             -> rules.GenSym(S)
        / '.gensym'                           -> rules.GenSym('gs')
        / '#' CPROD2:P                        -> rules.LengthOp(P)
        / '*' CPROD2:P                        -> rules.FlattenOp(P)
        / '*(' CPROD1:P ')'                   -> rules.FlattenOp(P)
        / '.line(' CPROD1:P ')'               -> rules.StructProd('builtin', 'Line', [P])
        / '.block(' CPROD1:P ')'              -> rules.StructProd('builtin', 'Block', [P])
        / '.join(' CPROD1:P ',' STRING:S ')'  -> rules.JoinOp(S, P)
        / '[]'                                -> rules.ListProd([])
        / '[' CPRODS:Ps ']'                   -> rules.ListProd(Ps)
        / '[' QITEMS:Is ']'                   -> rules.SpliceListProd(Is)
        / PVar:Name !DOTS                     -> rules.VarProd(Name)
        / PConst:Name !DOTS !'.'              -> rules.ConstProd(Name)
        / ID:Ns '.' ID:Func '(' CPRODS:Ps ')' -> rules.StructProd(Ns, Func, Ps)
        / ID:Ns '.' ID:Func                   -> rules.StructProd(Ns, Func, []) ;

GRAMMAR := '.grammar' ID:Name ( PCLASS / PTOKEN / PRULE / COMMENT )*:Rules
        -> [py.Compound('def target(driver, *args)',
               [py.Statement('driver.exe_name = "' Name '".lower() + "c"'),
                py.Ret('main, None')]),
            py.Compound('class ' Name 'Parser(object)',
               *[[py.Compound('def __init__(self, s, uf)',
                    [py.Statement('self.s = s; self.uf = uf'),
                     py.Statement('self.lastMatch = []'),
                     py.Statement('for name in unrolledRels: setattr(self, name, frozenRels[name](uf))'),
                     py.Statement('for l in unrolledLets: l(uf, self)')
                  ]),
                py.Statement('gs = 0'),
                py.Compound('def gensym(self, s)', [
                    py.Statement('self.gs += 1'),
                    py.Ret('s + str(self.gs).decode("utf-8")')
                ]),
                py.Compound('def parse(self)',
                    [py.Ret('self.parse' Name '(0)')])],
               *Rules]),
            py.Statement('MainParser = ' Name 'Parser')] ;

PCLASS := 'class' ID:Name '=' CLASSEXPR1:C ';'
       -> [py.Compound('def cls' Name '(self, c)', [py.Ret(C)])] ;
CLASSEXPR1 := CLASSEXPR2:L '|' CLASSEXPR1:R -> char.Either(L, R)
            / CLASSEXPR2 ;
CLASSEXPR2 := '.any'                                    -> char.Any
            / '.range(' WS Number:L ':' WS Number:U ')' -> char.Range(L, U)
            / '~' CLASSEXPR2:S                          -> char.Complement(S)
            / '(' CLASSEXPR1:S ')'                      -> S
            / WS Number:C                               -> char.Exactly(C)
            / ID:N                                      -> char.Call(N) ;

PTOKEN := 'token' ID:Name '=' PSCAN+:Scans ';'
       -> [py.Compound('def parse' Name '(self, i)',
                       *[[boundcheck, py.Statement('start = i; assert start >= 0')],
                       *Scans,
                       [py.Statement('rv = self.uf.makeStr(self.s[start:i])'),
                        py.Statement('self.lastMatch.append((u"TOKEN ' Name '", start, i))'),
                        py.Ret('i, rv')]])] ;
PSCAN := ID:Cls '*' -> [py.Statement('while i < len(self.s) and self.cls' Cls '(ord(self.s[i])): i += 1')]
       / ID:Cls '+' -> [py.RaiseIf('i >= len(self.s) or not self.cls' Cls '(ord(self.s[i]))'),
                        py.Statement('while i < len(self.s) and self.cls' Cls '(ord(self.s[i])): i += 1')]
       / ID:Cls     -> [py.RaiseIf('i >= len(self.s) or not self.cls' Cls '(ord(self.s[i]))'),
                        py.Statement('i += 1')] ;

PRULE := ID:Name ':=' PEXPR1:Expr ';'
       -> [py.Statement('@cached'),
           py.Compound('def parse' Name '(self, i)',
           *[[py.Statement('rel = self; uf = self.uf; st = []; env = CapEnv(uf)')], Expr, [py.Ret('i, rv')]])] ;
PEXPR1 := PEXPR2:This '/' PEXPR1:That -> peg.Choice(This, That)
        / PEXPR2 ;
PEXPR2 := PEXPR3:Exprs '->' CPROD1:Prod -> peg.Production(Exprs, Prod)
        / PEXPR3 ;
PEXPR3 := PEXPR4*:Exprs -> peg.Sequence(Exprs) ;
PEXPR4 := PEXPR5:Expr ':' PPATT:P -> peg.Capture(Expr, P)
        / PEXPR5 ;
PPATT := ID:Name -> peg.NamePatt(Name) ;
PEXPR5 := '&' PEXPR6:Expr -> peg.Positive(Expr)
        / '!' PEXPR6:Expr -> peg.Negative(Expr)
        / PEXPR6 ;
PEXPR6 := PEXPR7:Expr '*' -> peg.Any(Expr)
        / PEXPR7:Expr '+' -> peg.Some(Expr)
        / PEXPR7:Expr '?' -> peg.Maybe(Expr)
        / PEXPR7 ;
PEXPR7 := '(' PEXPR1:Expr ')'   -> Expr
        / STRING:S              -> peg.Token(S)
        / ID:Name               -> peg.Call(Name) ;

ZADDY := WS ( RULES / SIGNATURE / GRAMMAR / COMMENT )*:Clss WS
      -> *[[
          py.Statement('from rpython.rlib.rfile import create_stdio'),
          py.Statement('from rpython.rlib.objectmodel import specialize, r_dict, compute_hash'),
          py.Statement('from rpython.rlib.rarithmetic import intmask'),
          py.Statement('from rpython.rlib.unroll import unrolling_iterable'),
          py.Statement('from rpython.rlib.listsort import make_timsort_class'),
          py.Compound('class ParseError(Exception)', [
              py.Statement('def __init__(self, reason): self.reason = reason')
          ]),
          py.Compound('class NoResults(Exception)', [
              py.Statement('def __init__(self, message, handle): self.message = message; self.handle = handle')
          ]),
          py.Compound('class ZaddyError(Exception)', [
              py.Statement('def __init__(self, message): self.message = message')
          ]),
          py.Compound('class Result(object)', [
              py.Statement('pass')
          ]),
          py.Compound('class Failed(Result)', [
              py.Statement('pass')
          ]),
          py.Statement('failed = Failed()'),
          py.Compound('def cached(f, cacheCount=[0])', [
              py.Statement('attr = "t" + str(cacheCount[0]); cacheCount[0] += 1'),
              py.Statement('name = f.__name__'),
              py.Statement('uname = unicode(name)'),
              py.Compound('class CacheResult(Result)', [
                  py.Statement('def __init__(self, i, rv): setattr(self, attr, (i, rv))')
              ]),
              py.Statement('cache = {}'),
              py.Compound('def deco(self, i)', [
                  py.Statement('key = i'),
                  py.Statement('if key in cache and cache[key] is failed: raise ParseError("no reason")'),
                  py.Statement('elif key in cache: return getattr(cache[key], attr)'),
                  py.Statement('cache[key] = failed'),
                  py.Statement('i, rv = f(self, i)'),
                  py.Statement('cache[key] = CacheResult(i, rv)'),
                  py.Statement('self.lastMatch.append((uname, key, i))'),
                  py.Statement('return i, rv')
              ]),
              py.Statement('deco.__name__ = name'),
              py.Statement('return deco')
          ]),
          py.Statement('letNames = []'),
          py.Compound('def let(f)', [
              py.Statement('letNames.append(f)'),
              py.Statement('return f')
          ]),
          py.Statement('allRels = []'),
          py.Statement('ruleList = []'),
          py.Statement('FREE = 0'),
          py.Statement('COMM = 1'),
          py.Statement('ASSOC = 2'),
          py.Statement('AC = 3'),
          py.Statement('NSTR = 0'),
          py.Statement('NLIST = 1'),
          py.Statement('NSTRUCT = 2'),
          py.Statement('PRODUCTCAP = 64'),
          py.Statement('FLATCAP = 8'),
          py.Statement('EXTCAP = 8'),
          py.Statement('INF = 1 << 60'),
          py.Compound('class ENode(object)', [
              py.Compound('def __init__(self, kind, ns, con, ckind, s, args)', [
                  py.Statement('self.kind = kind; self.ns = ns; self.con = con; self.ckind = ckind'),
                  py.Statement('self.s = s; self.args = args; self.cls = 0'),
                  py.Statement('self.subsumed = False; self.dead = False')
              ]),
              py.Statement('def live(self): return not self.dead and not self.subsumed'),
              py.Statement('def tag(self): return self.ns + u"." + self.con')
          ]),
          py.Compound('def nodeEq(l, r)', [
              py.Statement('if l.kind != r.kind or l.ns != r.ns or l.con != r.con or l.s != r.s: return False'),
              py.Statement('if len(l.args) != len(r.args): return False'),
              py.Compound('for i in range(len(l.args))', [
                  py.Statement('if l.args[i] != r.args[i]: return False')
              ]),
              py.Statement('return True')
          ]),
          py.Compound('def nodeHash(n)', [
              py.Statement('h = n.kind * 1000003 + compute_hash(n.ns)'),
              py.Statement('h = intmask(h * 1000003 + compute_hash(n.con))'),
              py.Statement('h = intmask(h * 1000003 + compute_hash(n.s))'),
              py.Statement('for a in n.args: h = intmask(h * 1000003 + a)'),
              py.Statement('return h')
          ]),
          py.Compound('def sortInts(xs)', [
              py.Compound('for i in range(1, len(xs))', [
                  py.Statement('x = xs[i]; j = i - 1'),
                  py.Compound('while j >= 0 and xs[j] > x', [
                      py.Statement('xs[j + 1] = xs[j]; j -= 1')
                  ]),
                  py.Statement('xs[j + 1] = x')
              ])
          ]),
          py.Compound('def shortlexLess(l, r)', [
              py.Statement('if len(l) != len(r): return len(l) < len(r)'),
              py.Statement('return l < r')
          ]),
          py.Compound('def productInts(choices)', [
              py.Statement('rv = [[]]'),
              py.Compound('for cs in choices', [
                  py.Statement('nxt = []'),
                  py.Compound('for prefix in rv', [
                      py.Compound('for c in cs', [
                          py.Statement('if len(nxt) < PRODUCTCAP: nxt.append(prefix + c)')
                      ])
                  ]),
                  py.Statement('rv = nxt')
              ]),
              py.Statement('return rv')
          ]),
          py.Compound('class UF(object)', [
              py.Compound('def __init__(self)', [
                  py.Statement('self.parent = []'),
                  py.Statement('self.members = []'),
                  py.Statement('self.nodes = []'),
                  py.Statement('self.memo = r_dict(nodeEq, nodeHash)'),
                  py.Statement('self.strs = {}'),
                  py.Statement('self.byTag = {}'),
                  py.Statement('self.lists = []'),
                  py.Statement('self.changes = 0'),
