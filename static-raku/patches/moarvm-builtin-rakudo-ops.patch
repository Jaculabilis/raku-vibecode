diff --git a/src/core/dll.c b/src/core/dll.c
index 4c8fb65..a409c56 100644
--- a/src/core/dll.c
+++ b/src/core/dll.c
@@ -1,5 +1,54 @@
 #include "moar.h"
 
+/* Extensions linked into the executable instead of living in a shared
+ * library. A `loadlib` whose file name matches one of these is satisfied
+ * without dlopen, which static executables cannot do (musl's static dlopen
+ * always fails). The library is then marked with MVM_DLL_BUILTIN and its
+ * symbols are looked up here rather than with dlsym. */
+#ifdef MVM_BUILTIN_RAKUDO_OPS
+void Rakudo_ops_init(MVMThreadContext *tc);
+#endif
+
+typedef struct {
+    const char *lib;    /* file name without directory or extension */
+    const char *sym;
+    void       *address;
+} MVMBuiltinExtSym;
+
+static const MVMBuiltinExtSym builtin_syms[] = {
+#ifdef MVM_BUILTIN_RAKUDO_OPS
+    { "libperl6_ops_moar", "Rakudo_ops_init", (void *)Rakudo_ops_init },
+#endif
+    { NULL, NULL, NULL }
+};
+
+static char builtin_marker;
+#define MVM_DLL_BUILTIN ((DLLib *)&builtin_marker)
+
+/* Does the (possibly relative) library path name a builtin library? */
+static int is_builtin_lib(const char *path) {
+    const char *base = strrchr(path, '/');
+    size_t len;
+    base = base ? base + 1 : path;
+    len  = strcspn(base, ".");
+    for (const MVMBuiltinExtSym *b = builtin_syms; b->lib; b++)
+        if (strlen(b->lib) == len && strncmp(base, b->lib, len) == 0)
+            return 1;
+    return 0;
+}
+
+static void *find_builtin_sym(const char *sym) {
+    for (const MVMBuiltinExtSym *b = builtin_syms; b->lib; b++)
+        if (strcmp(b->sym, sym) == 0)
+            return b->address;
+    return NULL;
+}
+
+void MVM_dll_free_lib(DLLib *lib) {
+    if (lib != MVM_DLL_BUILTIN)
+        MVM_nativecall_free_lib(lib);
+}
+
 int MVM_dll_load(MVMThreadContext *tc, MVMString *name, MVMString *path) {
     char *cpath;
     DLLib *lib;
@@ -23,7 +72,7 @@ int MVM_dll_load(MVMThreadContext *tc, MVMString *name, MVMString *path) {
     }
 
     cpath = MVM_string_utf8_c8_encode_C_string(tc, path);
-    lib = MVM_nativecall_load_lib(cpath);
+    lib = is_builtin_lib(cpath) ? MVM_DLL_BUILTIN : MVM_nativecall_load_lib(cpath);
 
     if (!lib) {
         char *waste[] = { cpath, NULL };
@@ -76,7 +125,7 @@ int MVM_dll_free(MVMThreadContext *tc, MVMString *name) {
         MVM_exception_throw_adhoc_free(tc, waste, "cannot free in-use library '%s'", c_name);
     }
 
-    MVM_nativecall_free_lib(entry->lib);
+    MVM_dll_free_lib(entry->lib);
     entry->lib = NULL;
 
     uv_mutex_unlock(&tc->instance->mutex_dll_registry);
@@ -115,7 +164,9 @@ MVMObject * MVM_dll_find_symbol(MVMThreadContext *tc, MVMString *lib,
     }
 
     csym = MVM_string_utf8_c8_encode_C_string(tc, sym);
-    address = MVM_nativecall_find_sym(entry->lib, csym);
+    address = entry->lib == MVM_DLL_BUILTIN
+        ? find_builtin_sym(csym)
+        : MVM_nativecall_find_sym(entry->lib, csym);
     MVM_free(csym);
 
     if (!address) {
