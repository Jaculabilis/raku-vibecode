puts(third);         // expect: 0.3333333333333333
puts(lox_fn(nothing)); // expect: null
puts(p);             // expect: Point instance
puts(Point);         // expect: Point
puts(lox_fn);        // expect: <fn lox_fn>
puts(clock == clock); // expect: true
puts(third * 3 == 1); // expect: true
puts(len([third]));  // expect: 1
