// (Lox number literals are floats, so Monkey's "/" divides them as floats.)
var third = 1 / 3;
print third;         // expect: 0.3333333333333333
print 2 + 3 == 5;    // expect: true
fun lox_fn(a) { return a; }
class Point { init(x) { this.x = x; } }
var p = Point(3);
